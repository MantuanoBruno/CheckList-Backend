{
  "name": "checklist-backend",
  "version": "1.0.0",
  "description": "Backend do app de checklist que vou utilizar no restaurante",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node src/server.js",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "migration:up": "DOTENV_CONFIG_PATH=.env.development node -r dotenv/config node_modules/.bin/node-pg-migrate up -m infra/migrations",
    "migration:down": "DOTENV_CONFIG_PATH=.env.development node -r dotenv/config node_modules/.bin/node-pg-migrate down -m infra/migrations",
    "migration:create": "node-pg-migrate create -m infra/migrations create"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MantuanoBruno/CheckList-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MantuanoBruno/CheckList-Backend/issues"
  },
  "homepage": "https://github.com/MantuanoBruno/CheckList-Backend#readme",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
